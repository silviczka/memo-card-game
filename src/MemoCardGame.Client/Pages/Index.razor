@page "/"

<header class="game-header">
    <h1 class="game-title">Memo</h1>
    <p class="game-tagline">Flip two at a time - match pairs with pictures or sounds.</p>
</header>

@if (_gameId == null)
{
    <StartGamePanel BoardSizeOptions="@CurrentBoardSizeOptions"
                    MaxAttemptOptions="@MaxAttemptOptions"
                    BoardSize="@_boardSize"
                    BoardSizeChanged="@(v => _boardSize = v)"
                    AudioMode="@_audioMode"
                    AudioModeChanged="OnAudioModeChanged"
                    UseMaxAttempts="@_useMaxAttempts"
                    UseMaxAttemptsChanged="@(v => _useMaxAttempts = v)"
                    MaxAttempts="@_maxAttempts"
                    MaxAttemptsChanged="@(v => _maxAttempts = v)"
                    OnStart="StartGame" />
    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error" role="alert">@_error</p>
    }
}
else
{
    var shellEight = _activeBoardSize == 8;
    <div class="game-shell @(shellEight ? "game-shell--8" : "")">
        <GameToolbar Compact="@shellEight"
                     ShowHint="@(_state != null && !_state.IsFinished)"
                     ShowPulse="@_waitingResolve"
                     HintText="@CurrentTurnHint"
                     ShowFinishedStats="@(_state != null && _state.IsFinished)"
                     Score="@(_state?.Score ?? 0)"
                     MoveCount="@(_state?.MoveCount ?? 0)"
                     MaxAttempts="@_state?.MaxAttempts"
                     OnMenu="NewGame" />

    @if (_state != null && !shellEight)
    {
        <GameStats Score="@_state.Score"
                   MoveCount="@_state.MoveCount"
                   MaxAttempts="@_state.MaxAttempts"
                   Announce="true" />
    }

    @if (_state != null)
    {
        @if (_audioMode)
        {
            <div class="audio-help-row">
                <label class="check check--hint-toggle-compact">
                    <input type="checkbox" checked="@_showAudioColorHints" @onchange="OnAudioHintsChanged" class="check__input" />
                    <span class="check__box" aria-hidden="true"></span>
                    <span class="check__text">Hint markers</span>
                </label>
                <span class="info-tip" tabindex="0" aria-label="Need help? Show a matching color and shape for each sound pair.">
                    ?
                    <span class="info-tip__bubble" role="tooltip">Need help? Matching pairs share the same color and shape.</span>
                </span>
            </div>
        }
        @if (_state.IsFinished)
        {
            <GameStatusMessage AllPairsMatched="@_state.AllPairsMatched" OnPlayAgain="NewGame" />
        }
        else
        {
            @if (shellEight)
            {
                <div class="board-stack board-stack--8">
                    <BoardMeta8 HintText="@CurrentTurnHint"
                                ShowPulse="@_waitingResolve"
                                Score="@_state.Score"
                                MoveCount="@_state.MoveCount"
                                MaxAttempts="@_state.MaxAttempts" />
                    <div class="board-wrap board-wrap--in-stack">
                        <GameBoard BoardSize="@_state.BoardSize"
                                   Cards="@_state.Cards"
                                   MismatchOverlay="@_mismatchOverlay"
                                   WaitingResolve="@_waitingResolve"
                                   IsFinished="@_state.IsFinished"
                                   FlippedCountThisTurn="@_state.FlippedCountThisTurn"
                                   OnFlip="Flip"
                                   AudioMode="@_audioMode"
                                   ShowAudioHints="@_showAudioColorHints"
                                   PairColorHint="PairColorHint"
                                   PairShapeHint="PairShapeHint"
                                   EmojiUrl="EmojiImageUrl" />
                    </div>
                </div>
            }
            else
            {
                <div class="board-wrap">
                    <GameBoard BoardSize="@_state.BoardSize"
                               Cards="@_state.Cards"
                               MismatchOverlay="@_mismatchOverlay"
                               WaitingResolve="@_waitingResolve"
                               IsFinished="@_state.IsFinished"
                               FlippedCountThisTurn="@_state.FlippedCountThisTurn"
                               OnFlip="Flip"
                               AudioMode="@_audioMode"
                               ShowAudioHints="@_showAudioColorHints"
                               PairColorHint="PairColorHint"
                               PairShapeHint="PairShapeHint"
                               EmojiUrl="EmojiImageUrl" />
                </div>
            }
        }
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error" role="alert">@_error</p>
    }
    </div>
}
