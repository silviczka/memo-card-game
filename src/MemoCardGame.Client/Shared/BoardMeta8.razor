<div class="board-meta board-meta--8">
    <span class="board-meta__hint toolbar-hint @(ShowPulse ? "toolbar-hint__pulse" : "")" aria-live="polite">@HintText</span>
    <GameStats Score="@Score"
               MoveCount="@MoveCount"
               MaxAttempts="@MaxAttempts"
               AttemptsLabel="Att."
               CssClass="stats--board8"
               ItemCssClass="stat-pill--toolbar stat-pill--board8"
               Announce="true" />
</div>

@code {
    [Parameter]
    public string HintText { get; set; } = "";

    [Parameter]
    public bool ShowPulse { get; set; }

    [Parameter]
    public int Score { get; set; }

    [Parameter]
    public int MoveCount { get; set; }

    [Parameter]
    public int? MaxAttempts { get; set; }
}
